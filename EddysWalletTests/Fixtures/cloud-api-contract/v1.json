{
  "version": 3,
  "description": "Field-level public wire contract for the Cloud surface of the Eddie's Wallet backend. Backend tests assert every live response against this file (tests/api-contract.test.ts); the iOS client asserts its DTOs against the mirrored copy at EddysWalletTests/Fixtures/cloud-api-contract/v1.json. Field names and nullability here are the agreement between the two repositories: a mismatch is what let a fully ready backend look dark to the app and a granted purchase look rejected. Bump `version` and update both repositories together when the wire shape changes; the pinned version in each repository's test makes an unannounced change fail CI.",
  "typeLanguage": {
    "scalars": ["string", "number", "boolean", "string|null", "number|null", "boolean|null", "string[]"],
    "objects": "{ \"type\": \"object\" | \"object|null\" | \"object[]\", \"fields\": { ... } }",
    "const": "optional exact expected value for a field",
    "open": "set on an object whose keys are dynamic, e.g. per-field validation errors",
    "expectNull": "endpoint-level list of fields this particular response must render as null",
    "note": "Top-level and nested key sets are compared for exact equality: an added or removed field fails."
  },
  "endpoints": {
    "cloudAuthentication": {
      "method": "POST",
      "path": "/v1/auth/apple",
      "status": 201,
      "body": {
        "type": "object",
        "fields": {
          "token": "string",
          "expiresAt": "string",
          "parent": {
            "type": "object",
            "fields": {
              "provider": "string",
              "subject": "string",
              "email": "string|null"
            }
          }
        }
      }
    },
    "accountDeletion": {
      "method": "DELETE",
      "path": "/v1/account",
      "status": 200,
      "note": "Requires Authorization and one UUID Idempotency-Key. A terminal success returns status `deleted` or `already-deleted`; no partial or queued status permits the client to erase local data.",
      "body": {
        "type": "object",
        "fields": {
          "status": "string"
        }
      }
    },
    "capabilities": {
      "method": "GET",
      "path": "/v1/capabilities",
      "status": 200,
      "body": {
        "type": "object",
        "fields": {
          "cloudActivationAvailable": "boolean",
          "cloudServiceAvailable": "boolean",
          "products": {
            "type": "string[]",
            "const": [
              "com.kunchenguid.eddieswallet.cloud.monthly",
              "com.kunchenguid.eddieswallet.cloud.annual"
            ]
          }
        }
      }
    },
    "cloudContextBeforePurchase": {
      "method": "GET",
      "path": "/v1/cloud/context",
      "status": 200,
      "note": "Pre-purchase, both entitlement and household are null. A client DTO that requires either of them cannot decode this, which is the only shape a parent sees before they ever buy.",
      "expectNull": ["entitlement", "household"],
      "body": {
        "type": "object",
        "fields": {
          "storeAccountToken": "string",
          "entitlement": {
            "type": "object|null",
            "fields": {
              "state": "string",
              "accessUntil": "string|null",
              "graceExpiresAt": "string|null",
              "lastReconciledAt": "string|null",
              "active": "boolean"
            }
          },
          "household": {
            "type": "object|null",
            "fields": { "lineageId": "string", "authority": "string", "revision": "number" }
          },
          "capability": {
            "type": "object",
            "fields": { "newActivationsEnabled": "boolean", "serviceMode": "string" }
          }
        }
      }
    },
    "cloudContextActive": {
      "method": "GET",
      "path": "/v1/cloud/context",
      "status": 200,
      "note": "Household lineage, authority, and revision are nested under `household`, and `lineageId` is lower-camel with a lowercase `d`. The revision here is what the client must echo as If-Match on its next Cloud mutation.",
      "body": {
        "type": "object",
        "fields": {
          "storeAccountToken": "string",
          "entitlement": {
            "type": "object|null",
            "fields": {
              "state": "string",
              "accessUntil": "string|null",
              "graceExpiresAt": "string|null",
              "lastReconciledAt": "string|null",
              "active": "boolean"
            }
          },
          "household": {
            "type": "object|null",
            "fields": { "lineageId": "string", "authority": "string", "revision": "number" }
          },
          "capability": {
            "type": "object",
            "fields": { "newActivationsEnabled": "boolean", "serviceMode": "string" }
          }
        }
      }
    },
    "cloudTransactionVerified": {
      "method": "POST",
      "path": "/v1/cloud/transactions",
      "status": 200,
      "note": "A verified purchase returns the complete current Cloud context alongside its status, so the client can read the entitlement it was just granted and the revision its next write needs. Returning only {\"status\":\"verified\"} made a paid, server-granted purchase decode as a rejection and left the StoreKit transaction unfinished.",
      "body": {
        "type": "object",
        "fields": {
          "status": { "type": "string", "const": "verified" },
          "storeAccountToken": "string",
          "entitlement": {
            "type": "object|null",
            "fields": {
              "state": "string",
              "accessUntil": "string|null",
              "graceExpiresAt": "string|null",
              "lastReconciledAt": "string|null",
              "active": "boolean"
            }
          },
          "household": {
            "type": "object|null",
            "fields": { "lineageId": "string", "authority": "string", "revision": "number" }
          },
          "capability": {
            "type": "object",
            "fields": { "newActivationsEnabled": "boolean", "serviceMode": "string" }
          }
        }
      }
    },
    "cloudTransactionPending": {
      "method": "POST",
      "path": "/v1/cloud/transactions",
      "status": 202,
      "note": "Verification could not be completed with Apple. This is explicitly not a grant, so it carries no context and the client must ask again later.",
      "body": {
        "type": "object",
        "fields": {
          "status": { "type": "string", "const": "CLOUD_VERIFICATION_PENDING" }
        }
      }
    },
    "cloudLegacyContext": {
      "method": "GET",
      "path": "/v1/cloud/legacy-context",
      "status": 200,
      "note": "First-run discovery for a fresh device: whether this exact authenticated parent already has a server-held household, and the entitlement that would pay for its Cloud authority. `household` is null when the parent has none; `authority` is `legacy_service` before a transition, `cloud` after one, or `local_detached` after a detach. `exportAvailable` is true only for the two legacy authorities. The client must offer the consented transition only when `authority` is `legacy_service`; an already-`cloud` household is adopted through context/bootstrap instead.",
      "body": {
        "type": "object",
        "fields": {
          "household": {
            "type": "object|null",
            "fields": { "lineageId": "string", "authority": "string", "revision": "number" }
          },
          "entitlement": {
            "type": "object|null",
            "fields": {
              "state": "string",
              "accessUntil": "string|null",
              "graceExpiresAt": "string|null",
              "lastReconciledAt": "string|null",
              "active": "boolean"
            }
          },
          "exportAvailable": "boolean"
        }
      }
    },
    "cloudLegacyActivate": {
      "method": "POST",
      "path": "/v1/cloud/legacy-activate",
      "status": 200,
      "note": "The deliberate, user-accepted legacy-to-Cloud transition. Requires Authorization, Idempotency-Key, and If-Match with the revision discovery reported. The server derives parent and household from the session and accepts no identity from the body. The household transitions in place - same lineageId, every wallet fact preserved - and the response revision is the one the client's next Cloud read/write uses. Repeating the action against an already-transitioned household answers 200 with the current Cloud household (deterministic convergence for simultaneous devices), while a detached household stays a 409 CLOUD_HOUSEHOLD_CONFLICT.",
      "headers": { "etag": "^\"rev-[0-9]+\"$" },
      "body": {
        "type": "object",
        "fields": {
          "household": {
            "type": "object",
            "fields": { "lineageId": "string", "authority": { "type": "string", "const": "cloud" }, "revision": "number" }
          }
        }
      }
    },
    "cloudBootstrap": {
      "method": "GET",
      "path": "/v1/cloud/bootstrap",
      "status": 200,
      "note": "A loan's `schedule` is its durable installment plan - cadence, per-payment amount, and the anchor date every later due date is derived from - or null for a loan taken out without one. `loanOccurrences` are the durable payment occurrences across every loan of this wallet. Neither carries the next/missed projection: a replica must not embed \"today\". The client derives the reminder and the missed list on the device from the plan and its one scheduled occurrence.",
      "body": {
        "type": "object",
        "fields": {
          "household": {
            "type": "object",
            "fields": { "lineageId": "string", "authority": "string", "revision": "number" }
          },
          "family": { "type": "object", "fields": { "id": "string", "name": "string" } },
          "child": { "type": "object", "fields": { "id": "string", "nickname": "string", "avatarUrl": "string|null" } },
          "wallet": { "type": "object", "fields": { "id": "string", "balanceCents": "number", "currency": "string" } },
          "entries": {
            "type": "object[]",
            "fields": {
              "id": "string",
              "type": "string",
              "direction": "string",
              "amountCents": "number",
              "balanceBeforeCents": "number",
              "balanceAfterCents": "number",
              "reason": "string|null",
              "loanId": "string|null",
              "recordedAt": "string",
              "acceptedRevision": "number"
            }
          },
          "loans": {
            "type": "object[]",
            "fields": {
              "id": "string",
              "principalCents": "number",
              "outstandingCents": "number",
              "purpose": "string|null",
              "dueDate": "string|null",
              "status": "string",
              "createdAt": "string",
              "paidAt": "string|null",
              "schedule": {
                "type": "object|null",
                "fields": { "cadence": "string", "amountCents": "number", "firstDueDate": "string" }
              }
            }
          },
          "loanOccurrences": {
            "type": "object[]",
            "fields": {
              "id": "string",
              "loanId": "string",
              "dueOn": "string",
              "status": "string",
              "amountCents": "number|null",
              "acceptedEntryId": "string|null"
            }
          },
          "allowanceRule": {
            "type": "object|null",
            "fields": {
              "id": "string",
              "amountCents": "number",
              "cadence": "string",
              "weekday": "number",
              "startDate": "string",
              "endDate": "string|null",
              "active": "boolean"
            }
          },
          "nextCursor": "string|null"
        }
      }
    },
    "cloudHouseholdMutation": {
      "method": "POST",
      "path": "/v1/wallet/deposits",
      "status": 201,
      "note": "Cloud household writes carry If-Match: \"rev-N\" and answer with the new revision in both the body and the ETag response header.",
      "headers": { "etag": "^\"rev-[0-9]+\"$" },
      "body": {
        "type": "object",
        "fields": {
          "entry": {
            "type": "object",
            "fields": {
              "id": "string",
              "type": "string",
              "direction": "string",
              "amountCents": "number",
              "balanceBeforeCents": "number",
              "balanceAfterCents": "number",
              "reason": "string|null",
              "loanId": "string|null",
              "recordedBy": "string",
              "recordedAt": "string"
            }
          },
          "wallet": {
            "type": "object",
            "fields": { "id": "string", "currency": "string", "balanceCents": "number", "virtualNotice": "string" }
          },
          "revision": "number"
        }
      }
    },
    "allowanceSchedule": {
      "method": "GET",
      "path": "/v1/allowance-rule",
      "status": 200,
      "body": {
        "type": "object",
        "fields": {
          "allowanceRule": {
            "type": "object|null",
            "fields": {
              "id": "string",
              "amountCents": "number",
              "cadence": "string",
              "weekday": "number",
              "startDate": "string",
              "endDate": "string|null",
              "active": "boolean",
              "nextOccurrenceId": "string|null",
              "nextDueDate": "string|null"
            }
          }
        }
      }
    },
    "revisionConflictError": {
      "method": "POST",
      "path": "/v1/wallet/deposits",
      "status": 409,
      "note": "A stale If-Match mutates nothing and reports the household's current revision so the client can refresh and retry.",
      "body": {
        "type": "object",
        "fields": {
          "error": {
            "type": "object",
            "fields": {
              "code": { "type": "string", "const": "REVISION_CONFLICT" },
              "message": "string",
              "details": { "type": "object", "fields": { "currentRevision": "number" } }
            }
          }
        }
      }
    },
    "revisionRequiredError": {
      "method": "POST",
      "path": "/v1/cloud/legacy-detach",
      "status": 428,
      "body": {
        "type": "object",
        "fields": {
          "error": {
            "type": "object",
            "fields": {
              "code": { "type": "string", "const": "REVISION_REQUIRED" },
              "message": "string"
            }
          }
        }
      }
    },
    "validationError": {
      "method": "POST",
      "path": "/v1/wallet/deposits",
      "status": 400,
      "note": "Field-level failures carry a details object; every other error body is code and message only.",
      "body": {
        "type": "object",
        "fields": {
          "error": {
            "type": "object",
            "fields": {
              "code": { "type": "string", "const": "VALIDATION_ERROR" },
              "message": "string",
              "details": { "type": "object", "fields": { "formErrors": "string[]", "fieldErrors": { "type": "object", "fields": {}, "open": true } } }
            }
          }
        }
      }
    },
    "notFoundError": {
      "method": "GET",
      "path": "/v1/does-not-exist",
      "status": 404,
      "body": {
        "type": "object",
        "fields": {
          "error": {
            "type": "object",
            "fields": {
              "code": { "type": "string", "const": "NOT_FOUND" },
              "message": "string"
            }
          }
        }
      }
    }
  }
}
