#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=test/sim-policy-auth.sh
source "$SCRIPT_DIR/sim-policy-auth.sh"
if [[ "${1:-}" == "simctl" && "${2:-}" == "boot" ]]; then
    if ! _sim_policy_parent_owns_run || [[ "${3:-}" != "${SIM_UDID:-}" ]]; then
        echo "sim-policy: simctl boot must run through test/sim.sh" >&2
        exit 92
    fi
fi
exec "${EW_SIM_POLICY_REAL_XCRUN:-/usr/bin/xcrun}" "$@"
